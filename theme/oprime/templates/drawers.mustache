// Secondary Navigation Tabs - "More" dropdown toggle handler
document.addEventListener('click', function(e) {
    var moreToggle = e.target.closest('.dropdownmoremenu .dropdown-toggle, [data-region="morebutton"] .dropdown-toggle, #moremenu-dropdown-category');
    if (moreToggle) {
        e.preventDefault();
        e.stopPropagation();
        var parent = moreToggle.closest('.dropdownmoremenu, [data-region="morebutton"]');
        var menu = parent ? parent.querySelector('.dropdown-menu') : null;
        if (!menu) return;
        var isShown = menu.classList.contains('show') || parent.classList.contains('show');

        // Close any other open dropdowns
        document.querySelectorAll('.dropdownmoremenu.show, [data-region="morebutton"].show').forEach(function(el) {
            el.classList.remove('show');
            var btn = el.querySelector('.dropdown-toggle');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.dropdownmoremenu .dropdown-menu.show, [data-region="morebutton"] .dropdown-menu.show').forEach(function(el) {
            el.classList.remove('show');
        });

        if (!isShown) {
            parent.classList.add('show');
            menu.classList.add('show');
            moreToggle.setAttribute('aria-expanded', 'true');

            // Responsive boundary check: ensure dropdown never goes behind sidebar or off-screen
            var rect = menu.getBoundingClientRect();
            if (rect.left < 10) {
                menu.style.setProperty('left', '0px', 'important');
                menu.style.setProperty('right', 'auto', 'important');
            } else if (rect.right > window.innerWidth - 10) {
                menu.style.setProperty('left', 'auto', 'important');
                menu.style.setProperty('right', '0px', 'important');
            }
        }
        return;
    }

    if (!e.target.closest('.dropdownmoremenu, [data-region="morebutton"]')) {
        document.querySelectorAll('.dropdownmoremenu.show, [data-region="morebutton"].show').forEach(function(el) {
            el.classList.remove('show');
            var btn = el.querySelector('.dropdown-toggle');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.dropdownmoremenu .dropdown-menu.show, [data-region="morebutton"] .dropdown-menu.show').forEach(function(el) {
            el.classList.remove('show');
            el.style.removeProperty('left');
            el.style.removeProperty('right');
        });
    }
});

// Moodle Space Global Custom Dropdowns & Relative Calendar Controller
(function() {
    function isDateSelect(sel) {
        if (!sel) return false;
        var name = sel.getAttribute('name') || '';
        if (name.indexOf('[day]') !== -1 ||
            name.indexOf('[month]') !== -1 ||
            name.indexOf('[year]') !== -1 ||
            name.indexOf('[hour]') !== -1 ||
            name.indexOf('[minute]') !== -1) {
            return true;
        }
        return sel.closest('.fdate_time_selector, .fdate_selector') !== null;
    }

    function getAssociatedSelect(customDiv) {
        if (!customDiv) return null;
        if (customDiv._associatedSelect) return customDiv._associatedSelect;
        var prev = customDiv.previousElementSibling;
        while (prev) {
            if (prev.tagName === 'SELECT') return prev;
            prev = prev.previousElementSibling;
        }
        var parent = customDiv.parentNode;
        if (parent) {
            var sel = parent.querySelector('select');
            if (sel) return sel;
        }
        var row = customDiv.closest('.felement, .form-item, .fitem, [data-filterregion="filter"]');
        if (row) {
            return row.querySelector('select');
        }
        return null;
    }

    function buildMenuItems(select) {
        if (!select || !select.children) return '';
        var html = '';
        for (var i = 0; i < select.children.length; i++) {
            var child = select.children[i];
            if (child.tagName === 'OPTGROUP') {
                html += '<li class="dropdown-header font-weight-bold text-uppercase px-3 py-2 text-muted">' + (child.label || '') + '</li>';
                for (var j = 0; j < child.children.length; j++) {
                    var opt = child.children[j];
                    if (opt.disabled || opt.style.display === 'none') continue;
                    var isSelected = (opt.value === select.value) || opt.selected;
                    var activeClass = isSelected ? ' dropdown-item-active active' : '';
                    var ariaCurrent = isSelected ? ' aria-current="true"' : '';
                    html += '<li><a class="dropdown-item' + activeClass + '" data-value="' + opt.value + '" href="#"' + ariaCurrent + '>' + opt.text + '</a></li>';
                }
            } else if (child.tagName === 'OPTION') {
                var opt = child;
                if (opt.disabled || opt.style.display === 'none') continue;
                var isSelected = (opt.value === select.value) || opt.selected;
                var activeClass = isSelected ? ' dropdown-item-active active' : '';
                var ariaCurrent = isSelected ? ' aria-current="true"' : '';
                html += '<li><a class="dropdown-item' + activeClass + '" data-value="' + opt.value + '" href="#"' + ariaCurrent + '>' + opt.text + '</a></li>';
            }
        }
        return html;
    }

    function createOrSyncCustomDropdown(select) {
        if (!select || select.multiple || select.classList.contains('form-autocomplete-original-select') || select.getAttribute('size')) {
            return;
        }

        var customDiv = select.nextElementSibling;
        if (customDiv && customDiv.classList.contains('filter-custom-dropdown')) {
            customDiv._associatedSelect = select;
            select._customDropdown = customDiv;
            var btn = customDiv.querySelector('.filter-custom-toggle, .dropdown-toggle');
            if (btn) {
                btn.disabled = select.disabled;
                btn.classList.toggle('disabled', select.disabled);
                var textSpan = btn.querySelector('[data-active-item-text]');
                var activeOpt = select.options[select.selectedIndex];
                if (textSpan && activeOpt && textSpan.textContent !== activeOpt.text) {
                    textSpan.textContent = activeOpt.text;
                }
            }
            return;
        }

        // Visually hide native select without removing from DOM or layout calculations
        select.classList.add('sr-only-select');

        var name = select.getAttribute('name') || '';
        var typeClass = '';
        if (name.indexOf('[day]') !== -1) typeClass = ' filter-custom-dropdown-day';
        else if (name.indexOf('[month]') !== -1) typeClass = ' filter-custom-dropdown-month';
        else if (name.indexOf('[year]') !== -1) typeClass = ' filter-custom-dropdown-year';
        else if (name.indexOf('[hour]') !== -1) typeClass = ' filter-custom-dropdown-hour';
        else if (name.indexOf('[minute]') !== -1) typeClass = ' filter-custom-dropdown-minute';

        var selectedOpt = select.options[select.selectedIndex] || select.options[0];
        var initialText = selectedOpt ? selectedOpt.text : 'Select';

        var div = document.createElement('div');
        div.className = 'custom-select-menu filter-custom-dropdown position-relative d-inline-flex align-items-center' + typeClass;
        div._associatedSelect = select;
        select._customDropdown = div;

        div.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle filter-custom-toggle" aria-haspopup="true" aria-expanded="false"' + (select.disabled ? ' disabled' : '') + '>' +
                '<span data-active-item-text>' + initialText + '</span>' +
            '</button>' +
            '<ul class="dropdown-menu filter-custom-menu" role="menu">' +
                buildMenuItems(select) +
            '</ul>';

        select.parentNode.insertBefore(div, select.nextSibling);
    }

    function syncAllDropdowns() {
        // 1. Datafilter selects (participants page)
        var filterGroup = document.querySelector('.filter-group');
        if (filterGroup) {
            filterGroup.querySelectorAll('select[data-filterfield]').forEach(createOrSyncCustomDropdown);
        }

        // 2. All form single selects across course edit, general forms, and date/time selectors
        var formSelects = document.querySelectorAll('#page-course-edit .mform select:not([multiple]):not([size]), .mform .felement select:not([multiple]):not([size]), .form-item select:not([multiple]):not([size]), .fitem select:not([multiple]):not([size]), .fdate_time_selector select:not([multiple]):not([size]), .fdate_selector select:not([multiple]):not([size]), [data-fieldtype="date_time_selector"] select:not([multiple]):not([size]), [data-fieldtype="date_selector"] select:not([multiple]):not([size])');
        formSelects.forEach(createOrSyncCustomDropdown);

        // 3. Synchronize disabled/enabled state of calendar trigger buttons
        syncCalendarButtons();
    }

    // Check if a date selector row is currently disabled (via unchecked Enable checkbox or disabled select)
    function isRowDisabled(dateRow) {
        if (!dateRow) return false;
        var enableCheck = dateRow.querySelector('input[type="checkbox"][name*="[enabled]"]');
        if (enableCheck && !enableCheck.checked) {
            return true;
        }
        var firstSelect = dateRow.querySelector('select');
        if (firstSelect && firstSelect.disabled) {
            return true;
        }
        return false;
    }

    // Synchronize disabled/enabled visual state and attributes for all calendar trigger buttons
    function syncCalendarButtons() {
        var dateRows = document.querySelectorAll('.fdate_time_selector, .fdate_selector, [data-fieldtype="date_time_selector"], [data-fieldtype="date_selector"]');
        dateRows.forEach(function(row) {
            var calBtn = row.querySelector('a[name*="[calendar]"], a[id*="_calendar"], a[data-region="calendar-icon"], button[name*="[calendar]"]');
            if (!calBtn) return;
            var disabled = isRowDisabled(row);
            calBtn.classList.toggle('disabled', disabled);
            if (disabled) {
                calBtn.setAttribute('aria-disabled', 'true');
                calBtn.setAttribute('tabindex', '-1');
            } else {
                calBtn.removeAttribute('aria-disabled');
                calBtn.removeAttribute('tabindex');
                calBtn.removeAttribute('disabled');
            }
        });
    }

    // Relative Anchor & Display Controller for Date Selector Calendar
    function anchorPanelToTrigger(dateRow, calTrigger) {
        var panel = document.getElementById('dateselector-calendar-panel');
        if (!panel || !dateRow) return;

        // If the row is disabled, ensure panel is closed and return
        if (isRowDisabled(dateRow)) {
            closeCalendar(panel);
            return;
        }

        var btn = calTrigger || dateRow.querySelector('a[name*="[calendar]"], a[id*="_calendar"], a[data-region="calendar-icon"], button[name*="[calendar]"]');
        if (!btn) return;

        var btnRect = btn.getBoundingClientRect();

        // If the button has scrolled out of viewport, close calendar
        if (btnRect.bottom < 15 || btnRect.top > window.innerHeight - 15) {
            closeCalendar(panel);
            return;
        }

        // Ensure panel lives in document.body so it NEVER pollutes dateRow or gets corrupted by YUI's internal inputs query
        if (panel.parentNode !== document.body) {
            document.body.appendChild(panel);
        }

        panel._oprime_dateRow = dateRow;
        panel._oprime_calBtn = btn;

        // Calculate fixed viewport coordinates directly beneath the trigger button, right-aligned
        var panelWidth = Math.min(284, window.innerWidth - 24);
        var top = btnRect.bottom + 6;
        var left = btnRect.right - panelWidth;

        // If overflowing bottom of viewport, place above the button
        if (top + 280 > window.innerHeight && btnRect.top - 286 > 10) {
            top = btnRect.top - 286;
        }

        // Constrain horizontally
        if (left < 12) left = 12;
        if (left + panelWidth > window.innerWidth - 12) {
            left = window.innerWidth - panelWidth - 12;
        }

        // Heal any blank/NaN selects if corrupted by prior bug
        var yearSelect = dateRow.querySelector('select[name*="[year]"]');
        var monthSelect = dateRow.querySelector('select[name*="[month]"]');
        var daySelect = dateRow.querySelector('select[name*="[day]"]');
        var now = new Date();
        if (yearSelect && (!yearSelect.value || isNaN(parseInt(yearSelect.value, 10)) || yearSelect.selectedIndex === -1)) {
            yearSelect.value = String(now.getFullYear());
            if (yearSelect.selectedIndex === -1 && yearSelect.options.length > 0) yearSelect.selectedIndex = 0;
        }
        if (monthSelect && (!monthSelect.value || isNaN(parseInt(monthSelect.value, 10)) || monthSelect.selectedIndex === -1)) {
            monthSelect.value = String(now.getMonth() + 1);
            if (monthSelect.selectedIndex === -1 && monthSelect.options.length > 0) monthSelect.selectedIndex = now.getMonth();
        }
        if (daySelect && (!daySelect.value || isNaN(parseInt(daySelect.value, 10)) || daySelect.selectedIndex === -1)) {
            daySelect.value = String(now.getDate());
            if (daySelect.selectedIndex === -1 && daySelect.options.length > 0) daySelect.selectedIndex = Math.min(now.getDate() - 1, daySelect.options.length - 1);
        }

        // Ensure YUI calendar renders the date and calendar grid
        if (window.M && window.M.form && window.M.form.dateselector) {
            var ds = window.M.form.dateselector;
            if (ds.panel) {
                try { ds.panel.show(); } catch (err) {}
            }
            if (ds.calendar) {
                try {
                    ds.calendar.show();
                    if (yearSelect && monthSelect && daySelect) {
                        var y = parseInt(yearSelect.value, 10);
                        var m = parseInt(monthSelect.value, 10);
                        var d = parseInt(daySelect.value, 10);
                        if (!isNaN(y) && !isNaN(m) && !isNaN(d)) {
                            var selDate = new Date(y, m - 1, d);
                            ds.calendar.deselectDates();
                            ds.calendar.selectDates([selDate]);
                            ds.calendar.set('date', selDate);
                        }
                        var firstYear = yearSelect.options.length > 0 ? parseInt(yearSelect.options[0].value, 10) : (now.getFullYear() - 50);
                        var lastYear = yearSelect.options.length > 0 ? parseInt(yearSelect.options[yearSelect.options.length - 1].value, 10) : (now.getFullYear() + 50);
                        if (!isNaN(firstYear) && !isNaN(lastYear)) {
                            ds.calendar.set('minimumDate', new Date(firstYear, 0, 1));
                            ds.calendar.set('maximumDate', new Date(lastYear, 11, 31));
                        }
                    }
                    ds.calendar.render();
                } catch (err) {}
            }
        }

        // Apply compact styles
        panel.classList.remove('yui3-overlay-hidden', 'yui3-widget-hidden');
        panel.classList.add('oprime-calendar-open');
        panel.style.setProperty('position', 'fixed', 'important');
        panel.style.setProperty('top', top + 'px', 'important');
        panel.style.setProperty('left', left + 'px', 'important');
        panel.style.setProperty('right', 'auto', 'important');
        panel.style.setProperty('display', 'block', 'important');
        panel.style.setProperty('visibility', 'visible', 'important');
        panel.style.setProperty('z-index', '10060', 'important');

        var content = panel.querySelector('#dateselector-calendar-content');
        if (content) {
            content.style.setProperty('display', 'block', 'important');
            content.style.setProperty('visibility', 'visible', 'important');
        }

        // Synchronize and inject header custom dropdowns
        syncCalendarHeaderSelects(dateRow);
    }

    // Reposition open calendar when scrolling or resizing
    function repositionOpenCalendar(e) {
        // If scroll happened inside the calendar panel (e.g. scrolling the year menu), ignore
        if (e && e.target && (e.target.id === 'dateselector-calendar-panel' || (e.target.closest && e.target.closest('#dateselector-calendar-panel')))) {
            return;
        }

        var panel = document.getElementById('dateselector-calendar-panel');
        if (panel && panel.classList.contains('oprime-calendar-open') && panel._oprime_dateRow && panel._oprime_calBtn) {
            var btn = panel._oprime_calBtn;
            if (isRowDisabled(panel._oprime_dateRow)) {
                closeCalendar(panel);
                return;
            }

            var btnRect = btn.getBoundingClientRect();
            // If the button has scrolled out of viewport, close calendar
            if (btnRect.bottom < 15 || btnRect.top > window.innerHeight - 15) {
                closeCalendar(panel);
                return;
            }

            // Reposition smoothly without rebuilding DOM
            var panelWidth = Math.min(284, window.innerWidth - 24);
            var top = btnRect.bottom + 6;
            var left = btnRect.right - panelWidth;
            if (top + 280 > window.innerHeight && btnRect.top - 286 > 10) {
                top = btnRect.top - 286;
            }
            if (left < 12) left = 12;
            if (left + panelWidth > window.innerWidth - 12) {
                left = window.innerWidth - panelWidth - 12;
            }
            panel.style.setProperty('top', top + 'px', 'important');
            panel.style.setProperty('left', left + 'px', 'important');
        }

        // Close open dropdown menus on outer scroll so they don't float detached
        closeAllDropdowns();
    }
    window.addEventListener('resize', repositionOpenCalendar, { passive: true });
    window.addEventListener('scroll', repositionOpenCalendar, { capture: true, passive: true });

    // Interactive Month and Year Header Custom Dropdowns Controller
    function syncCalendarHeaderSelects(dateRow) {
        var panel = document.getElementById('dateselector-calendar-panel');
        if (!panel) return;

        if (!dateRow) {
            dateRow = panel._oprime_dateRow || panel.closest('.fdate_time_selector, .fdate_selector');
        }
        if (!dateRow) return;

        var headerLabel = panel.querySelector('.yui3-calendar-header-label');
        if (!headerLabel) return;

        var nativeMonth = dateRow.querySelector('select[name*="[month]"]');
        var nativeYear = dateRow.querySelector('select[name*="[year]"]');
        if (!nativeMonth || !nativeYear) return;

        var currentMonth = parseInt(nativeMonth.value, 10);
        var currentYear = parseInt(nativeYear.value, 10);

        if (window.M && window.M.form && window.M.form.dateselector && window.M.form.dateselector.calendar) {
            var calDate = window.M.form.dateselector.calendar.get('date');
            if (calDate instanceof Date && !isNaN(calDate)) {
                currentMonth = calDate.getMonth() + 1;
                currentYear = calDate.getFullYear();
            }
        }

        var wrapper = headerLabel.querySelector('.oprime-cal-header-selects');
        if (!wrapper) {
            wrapper = document.createElement('div');
            wrapper.className = 'oprime-cal-header-selects';

            // Month Custom Dropdown
            var monthDd = document.createElement('div');
            monthDd.className = 'oprime-cal-dd oprime-cal-month-dd position-relative';
            var monthBtn = document.createElement('button');
            monthBtn.type = 'button';
            monthBtn.className = 'oprime-cal-dd-btn';
            monthBtn.setAttribute('data-cal-dd', 'month');
            monthBtn.setAttribute('aria-haspopup', 'true');
            monthBtn.setAttribute('aria-expanded', 'false');
            monthBtn.innerHTML = '<span class="oprime-cal-dd-text"></span><span class="oprime-cal-dd-arrow"></span>';
            var monthMenu = document.createElement('ul');
            monthMenu.className = 'dropdown-menu oprime-cal-dd-menu';
            monthMenu.setAttribute('role', 'menu');

            Array.from(nativeMonth.options).forEach(function(opt) {
                var li = document.createElement('li');
                var a = document.createElement('a');
                a.className = 'dropdown-item';
                a.href = '#';
                a.setAttribute('data-value', opt.value);
                a.textContent = opt.textContent;
                li.appendChild(a);
                monthMenu.appendChild(li);
            });

            monthDd.appendChild(monthBtn);
            monthDd.appendChild(monthMenu);

            // Year Custom Dropdown
            var yearDd = document.createElement('div');
            yearDd.className = 'oprime-cal-dd oprime-cal-year-dd position-relative';
            var yearBtn = document.createElement('button');
            yearBtn.type = 'button';
            yearBtn.className = 'oprime-cal-dd-btn';
            yearBtn.setAttribute('data-cal-dd', 'year');
            yearBtn.setAttribute('aria-haspopup', 'true');
            yearBtn.setAttribute('aria-expanded', 'false');
            yearBtn.innerHTML = '<span class="oprime-cal-dd-text"></span><span class="oprime-cal-dd-arrow"></span>';
            var yearMenu = document.createElement('ul');
            yearMenu.className = 'dropdown-menu oprime-cal-dd-menu';
            yearMenu.setAttribute('role', 'menu');

            Array.from(nativeYear.options).forEach(function(opt) {
                var li = document.createElement('li');
                var a = document.createElement('a');
                a.className = 'dropdown-item';
                a.href = '#';
                a.setAttribute('data-value', opt.value);
                a.textContent = opt.textContent;
                li.appendChild(a);
                yearMenu.appendChild(li);
            });

            yearDd.appendChild(yearBtn);
            yearDd.appendChild(yearMenu);

            wrapper.appendChild(monthDd);
            wrapper.appendChild(yearDd);

            headerLabel.innerHTML = '';
            headerLabel.appendChild(wrapper);
        }

        // Update Month label and active state
        var mText = '';
        var selectedMonthOpt = Array.from(nativeMonth.options).find(function(o) { return parseInt(o.value, 10) === currentMonth; });
        if (selectedMonthOpt) mText = selectedMonthOpt.textContent;
        else mText = String(currentMonth);

        var monthTextSpan = wrapper.querySelector('.oprime-cal-month-dd .oprime-cal-dd-text');
        if (monthTextSpan && monthTextSpan.textContent !== mText) {
            monthTextSpan.textContent = mText;
        }

        wrapper.querySelectorAll('.oprime-cal-month-dd .dropdown-item').forEach(function(item) {
            var isAct = parseInt(item.getAttribute('data-value'), 10) === currentMonth;
            item.classList.toggle('active', isAct);
            item.classList.toggle('dropdown-item-active', isAct);
        });

        // Update Year label and active state
        var yearTextSpan = wrapper.querySelector('.oprime-cal-year-dd .oprime-cal-dd-text');
        if (yearTextSpan && yearTextSpan.textContent !== String(currentYear)) {
            yearTextSpan.textContent = String(currentYear);
        }

        wrapper.querySelectorAll('.oprime-cal-year-dd .dropdown-item').forEach(function(item) {
            var isAct = parseInt(item.getAttribute('data-value'), 10) === currentYear;
            item.classList.toggle('active', isAct);
            item.classList.toggle('dropdown-item-active', isAct);
        });
    }

    function updateCalendarDate(dateRow, monthVal, yearVal) {
        if (!window.M || !window.M.form || !window.M.form.dateselector || !window.M.form.dateselector.calendar) return;
        var cal = window.M.form.dateselector.calendar;
        var nativeDay = dateRow ? dateRow.querySelector('select[name*="[day]"]') : null;
        var dayVal = nativeDay ? parseInt(nativeDay.value, 10) : 1;
        var maxDays = new Date(yearVal, monthVal, 0).getDate();
        if (dayVal > maxDays) {
            dayVal = maxDays;
            if (nativeDay) {
                nativeDay.value = dayVal;
                nativeDay.dispatchEvent(new Event('change', {bubbles: true}));
            }
        }

        var targetDate = new Date(yearVal, monthVal - 1, dayVal);
        cal.set('date', targetDate);
        cal.render();

        setTimeout(function() {
            syncCalendarHeaderSelects(dateRow);
            syncAllDropdowns();
        }, 15);
    }

    function closeCalendar(panel) {
        if (!panel) panel = document.getElementById('dateselector-calendar-panel');
        if (!panel) return;
        panel.classList.remove('oprime-calendar-open');
        panel.classList.add('yui3-overlay-hidden');
        panel.style.setProperty('display', 'none', 'important');
        panel.style.setProperty('visibility', 'hidden', 'important');
        panel._oprime_dateRow = null;
        panel._oprime_calBtn = null;

        // Close any calendar header dropdowns
        panel.querySelectorAll('.oprime-cal-dd.show, .oprime-cal-dd .dropdown-menu.show').forEach(function(el) {
            el.classList.remove('show');
            var b = el.querySelector('.oprime-cal-dd-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
        });

        if (window.M && window.M.form && window.M.form.dateselector && window.M.form.dateselector.currentowner) {
            try {
                window.M.form.dateselector.currentowner.release_calendar();
            } catch(err) {}
        }
    }

    // Hook YUI dateselector fix_position
    function hookDateselector() {
        var panel = document.getElementById('dateselector-calendar-panel');
        if (panel && panel.parentNode !== document.body) {
            document.body.appendChild(panel);
        }

        if (window.M && window.M.form && window.M.form.dateselector && !window.M.form.dateselector._oprime_hooked) {
            window.M.form.dateselector._oprime_hooked = true;
            window.M.form.dateselector.fix_position = function() {
                if (this.currentowner) {
                    var node = this.currentowner.get('node');
                    var domNode = (node && node.getDOMNode) ? node.getDOMNode() : (document.getElementById(node.get('id')) || document.querySelector('.fdate_time_selector, .fdate_selector'));
                    var calImg = this.currentowner.calendarimage;
                    var calBtn = (calImg && calImg.getDOMNode) ? calImg.getDOMNode() : (calImg ? document.getElementById(calImg.get('id')) : null);
                    if (domNode && !isRowDisabled(domNode)) {
                        anchorPanelToTrigger(domNode, calBtn);
                    }
                }
            };

            // Hook panel hide to clear oprime-calendar-open
            if (window.M.form.dateselector.panel && !window.M.form.dateselector.panel._oprime_hooked) {
                window.M.form.dateselector.panel._oprime_hooked = true;
                var origPanelHide = window.M.form.dateselector.panel.hide;
                window.M.form.dateselector.panel.hide = function() {
                    var p = document.getElementById('dateselector-calendar-panel');
                    if (p) {
                        p.classList.remove('oprime-calendar-open');
                        p.classList.add('yui3-overlay-hidden');
                        p.style.setProperty('display', 'none', 'important');
                        p.style.setProperty('visibility', 'hidden', 'important');
                        p._oprime_dateRow = null;
                        p._oprime_calBtn = null;
                    }
                    return origPanelHide.apply(this, arguments);
                };
            }
        }
    }

    // Helper to close all custom dropdowns except the currently active one
    function closeAllDropdowns(exceptEl) {
        document.querySelectorAll('.filter-custom-dropdown.show, .filter-custom-dropdown .dropdown-menu.show, .oprime-cal-dd.show, .oprime-cal-dd .dropdown-menu.show').forEach(function(el) {
            if (exceptEl && (el === exceptEl || el.contains(exceptEl) || exceptEl.contains(el))) {
                return;
            }
            el.classList.remove('show');
            var b = el.querySelector('.filter-custom-toggle, .dropdown-toggle, .oprime-cal-dd-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
        });
    }

    // Global Click Listeners for Dropdowns and Calendar in Capture Phase
    function handleGlobalClicks(e) {
        // Handle Enable/Disable Checkbox Click
        var enableCheckbox = e.target.closest('input[type="checkbox"][name*="[enabled]"]');
        if (enableCheckbox) {
            setTimeout(function() {
                if (!enableCheckbox.checked) {
                    closeCalendar();
                }
                syncAllDropdowns();
            }, 10);
            return;
        }

        // 1. Calendar Trigger Click
        var calBtn = e.target.closest('a[name*="[calendar]"], a[id*="_calendar"], a[data-region="calendar-icon"], button[name*="[calendar]"]');
        if (calBtn) {
            e.preventDefault();
            e.stopPropagation();

            var dateRow = calBtn.closest('.fdate_time_selector, .fdate_selector, [data-fieldtype="date_time_selector"], [data-fieldtype="date_selector"]');

            if (isRowDisabled(dateRow)) {
                closeCalendar();
                return;
            }

            var panel = document.getElementById('dateselector-calendar-panel');
            if (panel && panel.classList.contains('oprime-calendar-open') && panel._oprime_calBtn === calBtn) {
                // Toggle close if clicking open button again
                closeCalendar(panel);
                return;
            }

            hookDateselector();

            // Render and anchor panel directly with calendar grid
            anchorPanelToTrigger(dateRow, calBtn);
            return;
        }

        // 2. Calendar Header Custom Dropdown Toggle Click
        var calDdBtn = e.target.closest('.oprime-cal-dd-btn');
        if (calDdBtn) {
            e.preventDefault();
            e.stopPropagation();

            var calDd = calDdBtn.closest('.oprime-cal-dd');
            if (!calDd) return;
            var menu = calDd.querySelector('.oprime-cal-dd-menu');
            if (!menu) return;

            var isShown = calDd.classList.contains('show');
            closeAllDropdowns(calDd);

            if (isShown) {
                calDd.classList.remove('show');
                menu.classList.remove('show');
                calDdBtn.setAttribute('aria-expanded', 'false');
            } else {
                calDd.classList.add('show');
                menu.classList.add('show');
                calDdBtn.setAttribute('aria-expanded', 'true');

                var activeItem = menu.querySelector('.active');
                if (activeItem) {
                    setTimeout(function() {
                        activeItem.scrollIntoView({ block: 'nearest' });
                    }, 10);
                }
            }
            return;
        }

        // 3. Calendar Header Custom Dropdown Item Click
        var calDdItem = e.target.closest('.oprime-cal-dd-menu .dropdown-item');
        if (calDdItem) {
            e.preventDefault();
            e.stopPropagation();

            var calDd = calDdItem.closest('.oprime-cal-dd');
            var panel = document.getElementById('dateselector-calendar-panel');
            var dateRow = panel ? panel._oprime_dateRow : null;
            if (!calDd || !panel || !dateRow) return;

            var isMonth = calDd.classList.contains('oprime-cal-month-dd');
            var val = parseInt(calDdItem.getAttribute('data-value'), 10);

            var nativeMonth = dateRow.querySelector('select[name*="[month]"]');
            var nativeYear = dateRow.querySelector('select[name*="[year]"]');

            var curMonth = nativeMonth ? parseInt(nativeMonth.value, 10) : 1;
            var curYear = nativeYear ? parseInt(nativeYear.value, 10) : new Date().getFullYear();

            if (window.M && window.M.form && window.M.form.dateselector && window.M.form.dateselector.calendar) {
                var cDate = window.M.form.dateselector.calendar.get('date');
                if (cDate instanceof Date && !isNaN(cDate)) {
                    curMonth = cDate.getMonth() + 1;
                    curYear = cDate.getFullYear();
                }
            }

            if (isMonth) {
                curMonth = val;
                if (nativeMonth) {
                    nativeMonth.value = val;
                    nativeMonth.dispatchEvent(new Event('change', {bubbles: true}));
                }
            } else {
                curYear = val;
                if (nativeYear) {
                    nativeYear.value = val;
                    nativeYear.dispatchEvent(new Event('change', {bubbles: true}));
                }
            }

            calDd.classList.remove('show');
            var m = calDd.querySelector('.oprime-cal-dd-menu');
            if (m) m.classList.remove('show');
            var b = calDd.querySelector('.oprime-cal-dd-btn');
            if (b) b.setAttribute('aria-expanded', 'false');

            updateCalendarDate(dateRow, curMonth, curYear);
            return;
        }

        // 4. Calendar Prev / Next Chevrons Navigation Click
        var calNavBtn = e.target.closest('.yui3-calendarnav-prevmonth, .yui3-calendarnav-nextmonth');
        if (calNavBtn) {
            setTimeout(function() {
                var panel = document.getElementById('dateselector-calendar-panel');
                var dateRow = panel ? panel._oprime_dateRow : null;
                if (dateRow && window.M && window.M.form && window.M.form.dateselector && window.M.form.dateselector.calendar) {
                    var calDate = window.M.form.dateselector.calendar.get('date');
                    if (calDate instanceof Date && !isNaN(calDate)) {
                        var m = calDate.getMonth() + 1;
                        var y = calDate.getFullYear();
                        var nativeMonth = dateRow.querySelector('select[name*="[month]"]');
                        var nativeYear = dateRow.querySelector('select[name*="[year]"]');
                        if (nativeMonth && parseInt(nativeMonth.value, 10) !== m) {
                            nativeMonth.value = m;
                            nativeMonth.dispatchEvent(new Event('change', {bubbles: true}));
                        }
                        if (nativeYear && parseInt(nativeYear.value, 10) !== y) {
                            nativeYear.value = y;
                            nativeYear.dispatchEvent(new Event('change', {bubbles: true}));
                        }
                    }
                    syncCalendarHeaderSelects(dateRow);
                    syncAllDropdowns();
                }
            }, 50);
            return;
        }

        // 5. Close calendar when clicking a day cell inside the calendar
        var dayCell = e.target.closest('#dateselector-calendar-panel td.yui3-calendar-day');
        if (dayCell) {
            var dayNum = parseInt(dayCell.textContent.trim(), 10);
            var panel = document.getElementById('dateselector-calendar-panel');
            var dateRow = panel ? panel._oprime_dateRow : null;

            if (dateRow && !isNaN(dayNum) && dayNum > 0) {
                var daySel = dateRow.querySelector('select[name*="[day]"]');
                if (daySel) {
                    daySel.value = dayNum;
                    daySel.dispatchEvent(new Event('change', {bubbles: true}));
                }
            }

            setTimeout(function() {
                closeCalendar();
                syncAllDropdowns();
            }, 60);
            return;
        }

        // 6. Custom Dropdown Toggle Click (Forms & Filters)
        var toggleBtn = e.target.closest('.filter-custom-dropdown .filter-custom-toggle, .filter-custom-dropdown .dropdown-toggle');
        if (toggleBtn) {
            e.preventDefault();
            e.stopPropagation();

            var customDiv = toggleBtn.closest('.filter-custom-dropdown');
            if (!customDiv) return;

            var select = getAssociatedSelect(customDiv);
            if (toggleBtn.disabled || (select && select.disabled)) return;

            var menu = customDiv.querySelector('.dropdown-menu');
            if (!menu) return;

            if (select) {
                menu.innerHTML = buildMenuItems(select);
            }

            var isCurrentlyShown = customDiv.classList.contains('show');
            closeAllDropdowns(customDiv);

            if (isCurrentlyShown) {
                customDiv.classList.remove('show');
                menu.classList.remove('show');
                toggleBtn.setAttribute('aria-expanded', 'false');
            } else {
                customDiv.classList.add('show');
                menu.classList.add('show');
                toggleBtn.setAttribute('aria-expanded', 'true');

                var activeItem = menu.querySelector('.active');
                if (activeItem) {
                    setTimeout(function() {
                        activeItem.scrollIntoView({ block: 'nearest' });
                    }, 10);
                }
            }
            return;
        }

        // 7. Custom Dropdown Item Click (Forms & Filters)
        var menuItem = e.target.closest('.filter-custom-dropdown .dropdown-item');
        if (menuItem) {
            e.preventDefault();
            e.stopPropagation();

            var custom = menuItem.closest('.filter-custom-dropdown');
            var sel = getAssociatedSelect(custom);
            var val = menuItem.getAttribute('data-value');

            if (sel) {
                sel.value = val;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
                sel.dispatchEvent(new Event('input', { bubbles: true }));
                if (window.jQuery) {
                    window.jQuery(sel).trigger('change');
                }
            }

            var span = custom ? custom.querySelector('[data-active-item-text]') : null;
            if (span) {
                span.textContent = menuItem.textContent.replace('✓', '').trim();
            }

            if (custom) {
                custom.classList.remove('show');
                var m = custom.querySelector('.dropdown-menu');
                if (m) m.classList.remove('show');
                var b = custom.querySelector('.filter-custom-toggle, .dropdown-toggle');
                if (b) b.setAttribute('aria-expanded', 'false');
            }

            // If calendar is open for this date row, keep calendar synchronized
            var panel = document.getElementById('dateselector-calendar-panel');
            if (panel && panel.classList.contains('oprime-calendar-open') && panel._oprime_dateRow) {
                var dRow = panel._oprime_dateRow;
                if (dRow.contains(custom) || dRow === custom.closest('.fdate_time_selector, .fdate_selector')) {
                    var mSel = dRow.querySelector('select[name*="[month]"]');
                    var ySel = dRow.querySelector('select[name*="[year]"]');
                    if (mSel && ySel) {
                        updateCalendarDate(dRow, parseInt(mSel.value, 10), parseInt(ySel.value, 10));
                    }
                }
            }
            return;
        }

        // 8. Close calendar when clicking outside
        var openPanel = document.querySelector('#dateselector-calendar-panel.oprime-calendar-open');
        if (openPanel) {
            var insidePanel = e.target.closest('#dateselector-calendar-panel');
            var insideCalBtn = e.target.closest('a[name*="[calendar]"], a[id*="_calendar"], a[data-region="calendar-icon"], button[name*="[calendar]"]');
            if (!insidePanel && !insideCalBtn) {
                closeCalendar(openPanel);
            }
        }

        // 9. Close dropdowns when clicking outside
        if (!e.target.closest('.filter-custom-dropdown, .oprime-cal-dd')) {
            closeAllDropdowns();
        }
    }

    document.addEventListener('click', handleGlobalClicks, true);

    // Synchronize toggle text on underlying select change
    document.addEventListener('change', function(e) {
        if (e.target && e.target.tagName === 'SELECT') {
            var select = e.target;
            var customDiv = select.nextElementSibling;
            if (customDiv && customDiv.classList.contains('filter-custom-dropdown')) {
                var activeOpt = select.options[select.selectedIndex];
                var textSpan = customDiv.querySelector('[data-active-item-text]');
                if (textSpan && activeOpt) {
                    textSpan.textContent = activeOpt.text;
                }
            }
        }
        if (e.target && e.target.type === 'checkbox' && (e.target.name.indexOf('[enabled]') !== -1 || e.target.closest('.fdate_time_selector, .fdate_selector'))) {
            setTimeout(syncAllDropdowns, 10);
        }
    });

    // Check periodically during page load to hook YUI dateselector and synchronize dropdowns
    var checkCount = 0;
    var initInterval = setInterval(function() {
        checkCount++;
        hookDateselector();
        syncAllDropdowns();
        if (checkCount >= 25) {
            clearInterval(initInterval);
        }
    }, 200);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncAllDropdowns);
    } else {
        syncAllDropdowns();
    }
})();

// Interactive Course Actions Handler (Star, Unstar, Hide, Restore)
require(['jquery', 'core/ajax', 'core/notification', 'core/pubsub', 'core_course/events', 'core_user/repository'], function($, ajax, Notification, PubSub, CourseEvents, UserRepository) {
    // Helper to keep both card star button and dropdown options perfectly synchronized
    function updateCourseFavouriteUI(courseId, isFav) {
        var $favBtn = $('[data-action="toggle-favourite"][data-course-id="' + courseId + '"]');
        $favBtn.toggleClass('is-favourite', isFav);
        var $isFavSpan = $favBtn.find('[data-region="is-favourite"]');
        var $notFavSpan = $favBtn.find('[data-region="not-favourite"]');

        if (isFav) {
            $isFavSpan.removeClass('hidden d-none');
            $notFavSpan.addClass('hidden d-none');
            $favBtn.attr('title', 'Unstar this course');
            $favBtn.attr('aria-label', 'Remove from favourites');
        } else {
            $isFavSpan.addClass('hidden d-none');
            $notFavSpan.removeClass('hidden d-none');
            $favBtn.attr('title', 'Star this course');
            $favBtn.attr('aria-label', 'Add to favourites');
        }

        // Sync dropdown menu options
        var $cards = $('[data-region="course-content"][data-course-id="' + courseId + '"], .rui-course-card[data-course-id="' + courseId + '"], .rui-course-list-item[data-course-id="' + courseId + '"]');
        $cards.find('[data-action="add-favourite"]').toggleClass('hidden d-none', isFav);
        $cards.find('[data-action="remove-favourite"]').toggleClass('hidden d-none', !isFav);
    }

    // 1. Star / Unstar from Card Quick-Button
    $(document).on('click', '[data-action="toggle-favourite"]', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $btn = $(this);
        var courseId = parseInt($btn.data('course-id'), 10);
        if (!courseId) return;

        var isFav = $btn.hasClass('is-favourite');
        var newFav = !isFav;

        updateCourseFavouriteUI(courseId, newFav);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: newFav }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(newFav ? CourseEvents.favourited : CourseEvents.unfavorited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, isFav);
            Notification.exception(err);
        });
    });

    // 2. Star this course from Dropdown Menu
    $(document).on('click', '[data-action="add-favourite"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        updateCourseFavouriteUI(courseId, true);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: true }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(CourseEvents.favourited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, false);
            Notification.exception(err);
        });
    });

    // 3. Unstar this course from Dropdown Menu
    $(document).on('click', '[data-action="remove-favourite"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        updateCourseFavouriteUI(courseId, false);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: false }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(CourseEvents.unfavorited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, true);
            Notification.exception(err);
        });
    });

    // 4. Remove from view (Hide Course)
    $(document).on('click', '[data-action="hide-course"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        var $card = $(this).closest('[data-region="course-content"], .rui-course-card, .rui-course-list-item');
        var $hideItem = $card.find('[data-action="hide-course"]');
        var $showItem = $card.find('[data-action="show-course"]');

        $hideItem.addClass('hidden d-none');
        $showItem.removeClass('hidden d-none');

        // Check active grouping filter
        var currentGrouping = $('[data-region="courses-view"]').attr('data-grouping');
        if (currentGrouping && currentGrouping !== 'allincludinghidden') {
            $card.fadeOut(250, function() {
                $(this).remove();
            });
        }

        UserRepository.setUserPreference('block_myoverview_hidden_course_' + courseId, true)
            .catch(function(err) {
                $hideItem.removeClass('hidden d-none');
                $showItem.addClass('hidden d-none');
                $card.show();
                Notification.exception(err);
            });
    });

    // 5. Restore to view (Show Course)
    $(document).on('click', '[data-action="show-course"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        var $card = $(this).closest('[data-region="course-content"], .rui-course-card, .rui-course-list-item');
        var $hideItem = $card.find('[data-action="hide-course"]');
        var $showItem = $card.find('[data-action="show-course"]');

        $showItem.addClass('hidden d-none');
        $hideItem.removeClass('hidden d-none');

        // Check active grouping filter
        var currentGrouping = $('[data-region="courses-view"]').attr('data-grouping');
        if (currentGrouping === 'hidden') {
            $card.fadeOut(250, function() {
                $(this).remove();
            });
        }

        UserRepository.setUserPreference('block_myoverview_hidden_course_' + courseId, null)
            .catch(function(err) {
                $showItem.removeClass('hidden d-none');
                $hideItem.addClass('hidden d-none');
                $card.show();
                Notification.exception(err);
            });
    });

    // PubSub events sync
    if (PubSub && CourseEvents) {
        PubSub.subscribe(CourseEvents.favourited, function(courseId) {
            updateCourseFavouriteUI(courseId, true);
        });
        PubSub.subscribe(CourseEvents.unfavorited, function(courseId) {
            updateCourseFavouriteUI(courseId, false);
        });
    }
});
