<script>
window.toggleSpaceSidebar = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var sidebar = document.getElementById('spaceMainSidebar');
    if (!sidebar) return;

    if (window.innerWidth < 992) {
        document.body.classList.remove('rui-sidebar-collapsed');
        var isOpen = document.body.classList.toggle('rui-sidebar-mobile-open');
        sidebar.classList.toggle('show', isOpen);
        if (isOpen) {
            sidebar.style.setProperty('transform', 'translateX(0)', 'important');
            sidebar.style.setProperty('visibility', 'visible', 'important');
            sidebar.style.setProperty('pointer-events', 'auto', 'important');
        } else {
            sidebar.style.removeProperty('transform');
            sidebar.style.removeProperty('visibility');
            sidebar.style.removeProperty('pointer-events');
        }
    } else {
        document.body.classList.remove('rui-sidebar-mobile-open');
        var isCollapsed = document.body.classList.toggle('rui-sidebar-collapsed');
        sidebar.classList.toggle('collapsed', isCollapsed);
        if (isCollapsed) {
            sidebar.style.setProperty('transform', 'translateX(-100%)', 'important');
            sidebar.style.setProperty('visibility', 'hidden', 'important');
            sidebar.style.setProperty('pointer-events', 'none', 'important');
        } else {
            sidebar.style.removeProperty('transform');
            sidebar.style.removeProperty('visibility');
            sidebar.style.removeProperty('pointer-events');
        }
        try {
            localStorage.setItem('space_sidebar_collapsed', isCollapsed ? '1' : '0');
        } catch(err) {}
    }
};

window.closeSpaceMobileSidebar = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    document.body.classList.remove('rui-sidebar-mobile-open');
    var sidebar = document.getElementById('spaceMainSidebar');
    if (sidebar) {
        sidebar.classList.remove('show');
        sidebar.style.removeProperty('transform');
        sidebar.style.removeProperty('visibility');
        sidebar.style.removeProperty('pointer-events');
    }
};

window.toggleCourseIndex = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var drawer = document.getElementById('theme_boost-drawers-courseindex');
    if (!drawer) return;
    var Drawers = (window.MoodleDrawers && window.MoodleDrawers.default) ? window.MoodleDrawers.default : window.MoodleDrawers;
    if (Drawers && typeof Drawers.getDrawerInstanceForNode === 'function') {
        var inst = Drawers.getDrawerInstanceForNode(drawer);
        if (inst) {
            inst.toggleVisibility();
            return;
        }
    }
    var isOpening = !drawer.classList.contains('show');
    drawer.classList.toggle('show', isOpening);
    drawer.setAttribute('aria-expanded', isOpening ? 'true' : 'false');
    document.body.classList.toggle('has-course-index-open', isOpening);
    var page = document.getElementById('page');
    if (page) page.classList.toggle('show-drawer-left', isOpening);
};

window.closeCourseIndex = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var drawer = document.getElementById('theme_boost-drawers-courseindex');
    if (drawer) {
        var Drawers = (window.MoodleDrawers && window.MoodleDrawers.default) ? window.MoodleDrawers.default : window.MoodleDrawers;
        if (Drawers && typeof Drawers.getDrawerInstanceForNode === 'function') {
            var inst = Drawers.getDrawerInstanceForNode(drawer);
            if (inst) {
                inst.closeDrawer();
                return;
            }
        }
        drawer.classList.remove('show');
        drawer.setAttribute('aria-expanded', 'false');
    }
    document.body.classList.remove('has-course-index-open');
    var page = document.getElementById('page');
    if (page) page.classList.remove('show-drawer-left');
};

window.toggleFocusMode = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    document.body.classList.toggle('rui-focus-mode');
    try {
        localStorage.setItem('space_focus_mode', document.body.classList.contains('rui-focus-mode') ? '1' : '0');
    } catch(err) {}
};

window.closeBlockDrawer = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var drawer = document.getElementById('theme_boost-drawers-blocks');
    if (!drawer) return;

    // 1. Try closing via Boost Drawers instance if available
    try {
        var Drawers = (window.MoodleDrawers && window.MoodleDrawers.default) ? window.MoodleDrawers.default : window.MoodleDrawers;
        if (Drawers && typeof Drawers.getDrawerInstanceForNode === 'function') {
            var inst = Drawers.getDrawerInstanceForNode(drawer);
            if (inst && typeof inst.closeDrawer === 'function') {
                inst.closeDrawer();
            }
        }
    } catch(err) {
        console.warn('Boost closeDrawer exception:', err);
    }

    // 2. Direct DOM and layout cleanup
    drawer.classList.remove('show');
    drawer.classList.add('hidden');
    drawer.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    drawer.style.setProperty('transform', 'translateX(100%)', 'important');
    drawer.style.setProperty('visibility', 'hidden', 'important');
    drawer.style.setProperty('pointer-events', 'none', 'important');

    var page = document.getElementById('page');
    if (page) {
        page.classList.remove('show-drawer-right');
        page.style.removeProperty('margin-right');
    }
    document.body.classList.remove('show-drawer-right');

    var btn = document.getElementById('hiddenSidebarToggle');
    if (btn) btn.setAttribute('aria-expanded', 'false');

    try {
        localStorage.setItem('space_blocks_open', '0');
        if (window.require) {
            require(['core_user/repository'], function(UserRepository) {
                if (UserRepository && typeof UserRepository.setUserPreference === 'function') {
                    UserRepository.setUserPreference('drawer-open-block', false);
                }
            });
        }
    } catch(err) {}
};

window.openBlockDrawer = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var drawer = document.getElementById('theme_boost-drawers-blocks');
    if (!drawer) return;

    try {
        var Drawers = (window.MoodleDrawers && window.MoodleDrawers.default) ? window.MoodleDrawers.default : window.MoodleDrawers;
        if (Drawers && typeof Drawers.getDrawerInstanceForNode === 'function') {
            var inst = Drawers.getDrawerInstanceForNode(drawer);
            if (inst && typeof inst.openDrawer === 'function') {
                inst.openDrawer();
            }
        }
    } catch(err) {
        console.warn('Boost openDrawer exception:', err);
    }

    drawer.classList.add('show');
    drawer.classList.remove('hidden');
    drawer.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    drawer.style.removeProperty('transform');
    drawer.style.removeProperty('visibility');
    drawer.style.removeProperty('pointer-events');

    var page = document.getElementById('page');
    if (page) page.classList.add('show-drawer-right');
    document.body.classList.add('show-drawer-right');

    var btn = document.getElementById('hiddenSidebarToggle');
    if (btn) btn.setAttribute('aria-expanded', 'true');

    try {
        localStorage.setItem('space_blocks_open', '1');
        if (window.require) {
            require(['core_user/repository'], function(UserRepository) {
                if (UserRepository && typeof UserRepository.setUserPreference === 'function') {
                    UserRepository.setUserPreference('drawer-open-block', true);
                }
            });
        }
    } catch(err) {}
};

window.toggleBlockDrawer = function(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var drawer = document.getElementById('theme_boost-drawers-blocks');
    if (!drawer) return;
    var isOpen = drawer.classList.contains('show') && drawer.style.visibility !== 'hidden';
    if (isOpen) {
        window.closeBlockDrawer(e);
    } else {
        window.openBlockDrawer(e);
    }
};

try {
    if (window.innerWidth >= 992) {
        if (localStorage.getItem('space_sidebar_collapsed') === '1') {
            document.body.classList.add('rui-sidebar-collapsed');
            var initSidebar = document.getElementById('spaceMainSidebar');
            if (initSidebar) {
                initSidebar.classList.add('collapsed');
                initSidebar.style.setProperty('transform', 'translateX(-100%)', 'important');
                initSidebar.style.setProperty('visibility', 'hidden', 'important');
                initSidebar.style.setProperty('pointer-events', 'none', 'important');
            }
        }
    } else {
        document.body.classList.remove('rui-sidebar-collapsed');
    }
    if (localStorage.getItem('space_focus_mode') === '1' && document.body.classList.contains('page-space-course')) {
        document.body.classList.add('rui-focus-mode');
    }
} catch(err) {}
</script>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="rui-space-wrapper d-print-block">

    {{{ output.standard_top_of_body_html }}}

    <!-- Top Navbar -->
    {{> theme_oprime/navbar }}

    <!-- Space Docked Left Sidebar (Screenshots 2, 3, 4, 5) -->
    {{> theme_oprime/sidebar }}
    <div class="rui-sidebar-backdrop d-lg-none" onclick="window.closeSpaceMobileSidebar(event)"></div>

    <!-- Course Index Drawer — Full height, sidebar width, with real 3-dot controls -->
    {{#courseindex}}
        <div class="drawer drawer-left rui-courseindex-drawer {{#courseindexopen}}show{{/courseindexopen}} d-print-none not-initialized"
             id="theme_boost-drawers-courseindex"
             data-region="fixed-drawer"
             data-preference="drawer-open-index"
             data-state="show-drawer-left"
             data-forceopen="0"
             data-close-on-resize="0">
            <div class="drawerheader rui-courseindex-drawer-header">
                <!-- Close (X) button — wired to Boost drawer JS and fallback -->
                <button class="btn drawertoggle rui-courseindex-close-btn icon-no-margin"
                        data-toggler="drawers"
                        data-action="closedrawer"
                        data-target="theme_boost-drawers-courseindex"
                        onclick="window.closeCourseIndex(event)"
                        data-toggle="tooltip"
                        data-placement="right"
                        title="{{#str}}closecourseindex, core{{/str}}"
                        aria-label="{{#str}}closecourseindex, core{{/str}}">
                    {{#pix}} e/cancel, core {{/pix}}
                </button>
                <!-- 3-dot dropdown: Expand all / Collapse all (+ JS injects Filter by activity / Filter by completion) -->
                <div class="drawerheadercontent rui-courseindex-controls">
                    {{> theme_boost/courseindexdrawercontrols}}
                </div>
            </div>
            <div class="drawercontent rui-courseindex-drawer-content drag-container" data-usertour="scroller">
                {{{courseindex}}}
            </div>
        </div>
    {{/courseindex}}

    <!-- Blocks Drawer -->
    {{#hasblocks}}
        <div class="drawer drawer-right rui-right-drawer rui-blocks-column rui-blocks-area {{#blockdraweropen}}show{{/blockdraweropen}} d-print-none" 
             id="theme_boost-drawers-blocks" 
             data-region="fixed-drawer" 
             data-preference="drawer-open-block" 
             data-state="show-drawer-right">
            <div class="drawerheader px-3 py-2 d-flex align-items-center justify-content-between border-bottom">
                <button type="button" class="btn btn-icon btn-dark drawertoggle rui-icon-no-margin" 
                        data-toggler="drawers"
                        data-action="closedrawer"
                        data-target="theme_boost-drawers-blocks"
                        onclick="window.closeBlockDrawer(event)"
                        id="drawerCloseButtonspace5-drawers-blocks" 
                        aria-label="Close block drawer"
                        title="Close block drawer"
                        aria-expanded="true">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.25 6.75L6.75 17.25"></path>
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 6.75L17.25 17.25"></path>
                    </svg>
                </button>
            </div>
            <div class="drawercontent drag-container p-3" data-usertour="scroller">
                <section class="d-print-none" aria-label="{{#str}}blocks{{/str}}">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </section>
            </div>
        </div>
    {{/hasblocks}}

    <!-- Main Content Stage -->
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers rui-main-stage {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner rui-stage-inner">
            <div id="page-content" class="page-content wrapper-page pb-3 d-print-block">

                <!-- Drawer Toggles (Top Right Toggle for Blocks Drawer) -->
                <div class="drawer-toggles d-flex align-items-center">
                    {{#hasblocks}}
                    <div id="sidepreopen-control" class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button type="button" 
                                class="btn border-0 icon-no-margin drawertoggle btn-close-drawer--right" 
                                data-toggler="drawers" 
                                data-action="toggle" 
                                data-target="theme_boost-drawers-blocks" 
                                aria-controls="theme_boost-drawers-blocks" 
                                aria-expanded="{{#blockdraweropen}}true{{/blockdraweropen}}{{^blockdraweropen}}false{{/blockdraweropen}}" 
                                id="hiddenSidebarToggle" 
                                onclick="window.toggleBlockDrawer(event)"
                                aria-label="Open block drawer" 
                                title="Open block drawer">
                            <span class="dir-rtl-hide">
                                <svg width="20" height="20" viewBox="0 0 20 20" version="1.1" xmlns="http://www.w3.org/2000/svg" style="fill-rule:evenodd;clip-rule:evenodd;" aria-hidden="true" focusable="false">
                                    <g transform="matrix(1,0,0,1,-2,0)">
                                        <path d="M18.333,15L18.333,5C18.333,3.629 17.205,2.5 15.833,2.5L14.167,2.5C12.795,2.5 11.667,3.629 11.667,5L11.667,15C11.667,16.371 12.795,17.5 14.167,17.5L15.833,17.5C17.205,17.5 18.333,16.371 18.333,15Z" style="fill:none;stroke:currentColor;stroke-width:1.67px;"></path>
                                    </g>
