{{!
    @template core/datafilter/filter

    Theme Oprime override for core/datafilter/filter:
    Clean Space Design System card layout.
}}
<div id="core-filter-{{uniqid}}" class="filter-group filter-area course-filter-card" data-table-region="{{tableregionid}}" data-table-course-id="{{courseid}}" data-filterverb="2">
    {{> core/datafilter/filter_match }}

    <div data-filterregion="filters" class="filter-rows-container">
        {{> core/datafilter/filter_row }}
    </div>

    <div class="filter-actions-bar d-flex flex-row align-items-center" data-filterregion="actions">
        <button type="button" class="btn btn-link filter-action-add text-reset" data-filteraction="add">
            {{#pix}}t/add{{/pix}}<span class="pl-2">{{#str}}addcondition{{/str}}</span>
        </button>
        <button data-filteraction="reset" type="button" class="btn btn-secondary filter-action-clear ml-auto mr-2">{{#str}}clearfilters{{/str}}</button>
        <button data-filteraction="apply" type="button" class="btn btn-primary filter-action-apply">{{#str}}applyfilters{{/str}}</button>
    </div>

    {{> core/datafilter/filter_types }}

</div>
