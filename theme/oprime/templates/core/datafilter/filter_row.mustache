{{!
    @template core/datafilter/filter_row

    Theme Oprime override for core/datafilter/filter_row:
    Native Space Design System dropdowns directly rendered to completely eliminate any FOUC or delay.
}}
<div data-filterregion="filter" data-filter-type="" class="filter-row-item">
    <fieldset>
        <legend class="sr-only">{{#str}}filterrowlegend, core, {{rownumber}}{{/str}}</legend>
        <div class="filter-row-controls d-flex flex-row align-items-center flex-wrap mr-0 ml-0 row">
            <div class="filter-row-join d-inline-flex flex-row align-items-center mr-2">
                <label for="core-filter_row-jointype-{{uniqid}}" class="mr-2 mb-0 filter-row-label">{{#str}}match{{/str}}</label>
                <select class="custom-select filter-select-input d-none" data-filterfield="join" id="core-filter_row-jointype-{{uniqid}}" style="display: none !important;">
                    <option value="0">{{#str}}none{{/str}}</option>
                    <option selected=selected value="1">{{#str}}any{{/str}}</option>
                    <option value="2">{{#str}}all{{/str}}</option>
                </select>
                <div class="dropdown select-menu category-selector-dropdown filter-custom-dropdown position-relative d-inline-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span data-active-item-text>{{#str}}any{{/str}}</span>
                    </button>
                    <ul class="dropdown-menu" role="menu">
                        <li><a class="dropdown-item" data-value="0" href="#">{{#str}}none{{/str}}</a></li>
                        <li><a class="dropdown-item dropdown-item-active active" data-value="1" href="#" aria-current="true">{{#str}}any{{/str}}</a></li>
                        <li><a class="dropdown-item" data-value="2" href="#">{{#str}}all{{/str}}</a></li>
                    </ul>
                </div>
            </div>

            <label class="sr-only" for="core-filter_row-filtertype-{{uniqid}}">{{#str}}filtertype{{/str}}</label>
            <select class="custom-select filter-select-input d-none mr-2" data-filterfield="type" id="core-filter_row-filtertype-{{uniqid}}" style="display: none !important;">
                <option value="">{{#str}}selectfiltertype{{/str}}</option>
                {{#filtertypes}}
                <option value="{{name}}">{{title}}</option>
                {{/filtertypes}}
            </select>
            <div class="dropdown select-menu category-selector-dropdown filter-custom-dropdown position-relative d-inline-flex align-items-center mr-2">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span data-active-item-text>{{#str}}selectfiltertype{{/str}}</span>
                </button>
                <ul class="dropdown-menu" role="menu">
                    {{#filtertypes}}
                    <li><a class="dropdown-item" data-value="{{name}}" href="#">{{title}}</a></li>
                    {{/filtertypes}}
                </ul>
            </div>

            <div data-filterregion="value" class="filter-row-value d-inline-flex flex-row align-items-center mr-2"></div>

            <button data-filteraction="remove" class="ml-auto icon-no-margin icon-size-4 btn text-reset filter-row-remove" aria-label="{{#str}}clearfilterrow{{/str}}">
                {{#pix}}e/cancel_solid_circle{{/pix}}
            </button>
        </div>
        <div data-filterregion="joinadverb" class="pl-1 text-uppercase font-weight-bold">
            <div data-filterverbfor="0">{{#str}}operator_andnot{{/str}}</div>
            <div data-filterverbfor="1">{{#str}}operator_or{{/str}}</div>
            <div data-filterverbfor="2">{{#str}}operator_and{{/str}}</div>
        </div>
    </fieldset>
</div>
