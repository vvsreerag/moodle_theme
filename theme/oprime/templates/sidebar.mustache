{{!
    Space Moodle Theme - Left Docked Sidebar
    Matches Rosea Space 5.0.7 Reference (Screenshots 2, 3, 4, 5)
}}
<aside class="rui-sidebar" id="spaceMainSidebar">
    <div class="rui-sidebar-inner">
        <!-- 1. Space Brand Header with Graduation Cap Logo -->
        <div class="rui-sidebar-header d-flex align-items-center justify-content-between">
            <a href="{{{ config.homeurl }}}" class="rui-sidebar-brand-link">
                <svg class="rui-sidebar-cap-logo" width="34" height="34" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 6L4 16L24 26L44 16L24 6Z" stroke="#2563eb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10 20V31C10 35.5 16.5 39.5 24 39.5C31.5 39.5 38 35.5 38 31V20" stroke="#2563eb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M44 16V28" stroke="#2563eb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="rui-sidebar-brand-text">GSL</span>
            </a>
            <button class="btn rui-sidebar-close-btn d-lg-none" type="button" onclick="window.closeSpaceMobileSidebar(event)" aria-label="Close sidebar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- 2. Search Field with Arrow Icon -->
        <div class="rui-sidebar-search-wrap">
            <form action="{{config.wwwroot}}/course/search.php" method="get" class="rui-sidebar-search-form">
                <span class="rui-sidebar-search-icon"><i class="fa fa-search"></i></span>
                <input type="text" name="search" class="rui-sidebar-search-input" placeholder="Search" autocomplete="off" />
                <button type="submit" class="rui-sidebar-search-submit" aria-label="Search">
                    <i class="fa fa-arrow-right"></i>
                </button>
            </form>
        </div>

        <!-- 3. Primary Navigation Menu -->
        <nav class="rui-sidebar-nav">
            <ul class="rui-sidebar-menu">
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/?redirect=0" class="rui-sidebar-link {{#issitehome}}active{{/issitehome}}">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-home"></i></span>
                        <span class="rui-sidebar-item-text">Site home</span>
                    </a>
                </li>
                {{#canviewdashboard}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/my/" class="rui-sidebar-link {{#isdashboard}}active{{/isdashboard}}">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-th-large"></i></span>
                        <span class="rui-sidebar-item-text">Dashboard</span>
                    </a>
                </li>
                {{/canviewdashboard}}
                {{#canviewmycourses}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/my/courses.php" class="rui-sidebar-link {{#ismycourses}}active{{/ismycourses}}">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-graduation-cap"></i></span>
                        <span class="rui-sidebar-item-text">My courses</span>
                    </a>
                </li>
                {{/canviewmycourses}}
                {{#canviewcalendar}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/calendar/view.php?view=month" class="rui-sidebar-link {{#iscalendar}}active{{/iscalendar}}">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-calendar-o"></i></span>
                        <span class="rui-sidebar-item-text">Calendar</span>
                    </a>
                </li>
                {{/canviewcalendar}}
                {{#canviewprivatefiles}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/user/files.php" class="rui-sidebar-link {{#isuserfiles}}active{{/isuserfiles}}">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-folder-o"></i></span>
                        <span class="rui-sidebar-item-text">Private files</span>
                    </a>
                </li>
                {{/canviewprivatefiles}}
                {{#canviewcontentbank}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/contentbank/index.php" class="rui-sidebar-link">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-database"></i></span>
                        <span class="rui-sidebar-item-text">Content bank</span>
                    </a>
                </li>
                {{/canviewcontentbank}}
                {{#issiteadmin}}
                <li class="rui-sidebar-item">
                    <a href="{{config.wwwroot}}/admin/search.php" class="rui-sidebar-link">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-cog"></i></span>
                        <span class="rui-sidebar-item-text">Site administration</span>
                    </a>
                </li>
                {{/issiteadmin}}
                {{^isloggedin}}
                <li class="rui-sidebar-item rui-sidebar-login-item">
                    <a href="{{loginurl}}" class="rui-sidebar-link rui-sidebar-login-link font-weight-bold">
                        <span class="rui-sidebar-item-icon"><i class="fa fa-sign-in"></i></span>
                        <span class="rui-sidebar-item-text">Log in</span>
                    </a>
                </li>
                {{/isloggedin}}
            </ul>

            <!-- 4. Course Categories Accordion -->
            {{#hassidebarcategories}}
            <div class="rui-sidebar-section">
                <div class="rui-sidebar-section-header" data-toggle="collapse" data-target="#sidebarCategories" aria-expanded="true">
                    <span class="rui-sidebar-section-title">
                        <i class="fa fa-folder-open-o mr-2"></i> Course categories
                    </span>
                    <i class="fa fa-chevron-down rui-collapse-arrow"></i>
                </div>
                <div class="collapse show" id="sidebarCategories">
                    <ul class="rui-sidebar-sublist">
                        {{#sidebarcategories}}
                        <li class="rui-sidebar-subitem">
                            <a href="{{url}}" class="rui-sidebar-sublink {{#isactive}}active{{/isactive}}">
                                <span class="rui-sidebar-cat-name">{{name}}</span>
                                <span class="rui-sidebar-cat-count">{{coursecount}}</span>
                            </a>
                        </li>
                        {{/sidebarcategories}}
                    </ul>
                </div>
            </div>
            {{/hassidebarcategories}}

            <!-- 5. My Courses Accordion with Progress Bars -->
            {{#hasmycourses}}
            <div class="rui-sidebar-section">
                <div class="rui-sidebar-section-header" data-toggle="collapse" data-target="#sidebarMyCourses" aria-expanded="true">
                    <span class="rui-sidebar-section-title">
                        <i class="fa fa-graduation-cap mr-2"></i> My courses
                    </span>
                    <i class="fa fa-chevron-down rui-collapse-arrow"></i>
                </div>
                <div class="collapse show" id="sidebarMyCourses">
                    <div class="rui-sidebar-filter-strip">
                        <label class="rui-switch-label">
                            <input type="checkbox" id="onlyInProgress" checked>
                            <span class="rui-switch-slider"></span>
                            <span class="rui-switch-text">Only courses in progress</span>
                        </label>
                        <div class="rui-sidebar-mini-search">
                            <i class="fa fa-search"></i>
                            <input type="text" placeholder="Search" onkeyup="var q=this.value.toLowerCase(); document.querySelectorAll('.rui-sidebar-course-item').forEach(function(el){ el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none'; });" />
                        </div>
                    </div>

                    <ul class="rui-sidebar-courses-list">
                        {{#sidebarmycourses}}
                        <li class="rui-sidebar-course-item">
                            <a href="{{url}}" class="rui-sidebar-course-link">
                                <span class="rui-sidebar-course-checkbox"><i class="fa fa-square-o"></i></span>
                                <span class="rui-sidebar-course-name">{{fullname}}</span>
                            </a>
                            <div class="rui-sidebar-course-progress">
                                <div class="rui-sidebar-progress-bar" style="width: {{progress}}%;"></div>
                                <span class="rui-sidebar-progress-num">{{progress}}%</span>
                            </div>
                        </li>
                        {{/sidebarmycourses}}
                    </ul>
                </div>
            </div>
            {{/hasmycourses}}
        </nav>

        <!-- 6. Bottom Sticky Area: Edit Mode Switch -->
        {{#canedit}}
        <div class="rui-sidebar-footer">
            <div class="rui-sidebar-editmode d-flex align-items-center">
                <!-- <span class="rui-sidebar-edit-icon mr-2"><i class="fa fa-pencil"></i></span>
                <span class="rui-sidebar-edit-label mr-auto font-weight-medium">Edit mode</span> -->
                {{{ output.edit_switch }}}
            </div>
        </div>
        {{/canedit}}
    </div>
</aside>
