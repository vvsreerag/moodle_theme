{{!
    Space Moodle Theme - Modern Navbar
    Matches Rosea Space 5.0.7 Reference (Screenshots 2, 3, 4)
}}
<nav class="navbar fixed-top navbar-light bg-white navbar-expand rui-space-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">

    <!-- Left Sidebar Toggle Button [ | ] -->
    <button class="btn rui-sidebar-toggle-btn mr-2" data-action="toggle-space-sidebar" id="spaceSidebarToggle" aria-label="Toggle Sidebar" type="button" onclick="window.toggleSpaceSidebar(event)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none;">
            <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
    </button>

    <!-- Topbar Graduation Cap Icon Link -->
    <a href="{{{ config.homeurl }}}" class="rui-topbar-cap-link mr-3 d-none d-md-flex align-items-center" title="Space">
        <svg width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 6L4 16L24 26L44 16L24 6Z" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 20V31C10 35.5 16.5 39.5 24 39.5C31.5 39.5 38 35.5 38 31V20" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M44 16V28" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </a>

    <!-- Top Navigation Custom Links as in Space Theme -->
    <ul class="navbar-nav rui-topbar-nav d-none d-lg-flex align-items-center">
        
        {{#issiteadmin}}
        <!-- <li class="nav-item">
            <a class="nav-link font-weight-medium" href="{{config.wwwroot}}/admin/search.php">Site administration</a>
        </li> -->
        {{/issiteadmin}}
    </ul>

    <!-- Right Side Utility Icons matching Screenshots 1-5 (Bell, Messages, Bookmark, Avatar, Drawer) -->
    <div id="usernavigation" class="navbar-nav ml-auto align-items-center">
        {{#isloggedin}}
        <div class="rui-topbar-quick-icons d-flex align-items-center">
            <!-- Notification Bell & Message Chat (Native Moodle Popover container styled as slide-out drawers) -->
            <div class="rui-popover-wrapper d-flex align-items-center">
                {{{ output.navbar_plugin_output }}}
            </div>

            <!-- Bookmark Ribbon Icon -->
            <a href="#" class="rui-icon-btn d-none d-sm-inline-flex" title="Bookmarks">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            </a>
        </div>
        {{/isloggedin}}

        {{#langmenu}}
            {{> theme_boost/language_menu }}
        {{/langmenu}}

        <!-- User Profile Avatar Menu -->
        <div class="d-flex align-items-stretch usermenu-container ml-1" data-region="usermenu">
            {{#usermenu}}
                {{> core/user_menu }}
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
