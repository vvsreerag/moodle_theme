{{!
    Space Moodle Theme - Modern Navbar
    Matches Rosea Space 5.0.7 Reference
}}
<nav class="navbar fixed-top navbar-light bg-white navbar-expand rui-space-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">

    <!-- Left Sidebar Toggle Button -->
    <button class="btn rui-sidebar-toggle-btn mr-2" data-action="toggle-space-sidebar" id="spaceSidebarToggle" aria-label="Toggle Sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
    </button>

    <!-- Topbar Graduation Cap Icon Link -->
    <a href="{{{ config.homeurl }}}" class="rui-topbar-cap-link mr-3 d-none d-md-flex align-items-center" title="Space">
        <svg width="22" height="22" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 6L4 16L24 26L44 16L24 6Z" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 20V31C10 35.5 16.5 39.5 24 39.5C31.5 39.5 38 35.5 38 31V20" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M44 16V28" stroke="#2563eb" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </a>

    <!-- Top Navigation Custom Links as in Space Theme -->
    <ul class="navbar-nav rui-topbar-nav d-none d-lg-flex align-items-center">
        <li class="nav-item">
            <a class="nav-link font-weight-medium" href="{{config.wwwroot}}/my/">Get Space Theme</a>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle font-weight-medium" href="#" id="worthLookDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Worth a Look
            </a>
            <div class="dropdown-menu shadow-sm border-0" aria-labelledby="worthLookDropdown">
                <a class="dropdown-item" href="{{config.wwwroot}}/course/index.php">Browse Courses</a>
                <a class="dropdown-item" href="{{config.wwwroot}}/calendar/view.php">Calendar Events</a>
                <a class="dropdown-item" href="{{config.wwwroot}}/user/files.php">Private Files</a>
            </div>
        </li>
    </ul>

    {{#primarymoremenu}}
        <div class="primary-navigation d-none d-xl-flex">
            {{> core/moremenu}}
        </div>
    {{/primarymoremenu}}

    <!-- Right Side Utility Icons -->
    <div id="usernavigation" class="navbar-nav ml-auto align-items-center">
        <!-- Quick Action Icons (Flag, Bell, Messages, Bookmark) -->
        <div class="rui-topbar-quick-icons d-none d-sm-flex align-items-center">
            <a href="#" class="rui-icon-btn" title="Site Flag">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
            </a>
        </div>

        {{#langmenu}}
            {{> theme_boost/language_menu }}
        {{/langmenu}}

        {{{ output.navbar_plugin_output }}}

        <!-- User Profile Avatar Menu -->
        <div class="d-flex align-items-stretch usermenu-container ml-2" data-region="usermenu">
            {{#usermenu}}
                {{> core/user_menu }}
            {{/usermenu}}
        </div>

        {{{ output.edit_switch }}}

        <!-- Right Side Block Drawer Toggler -->
        <button class="btn rui-block-drawer-toggle ml-2 d-none d-md-flex align-items-center justify-content-center" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" title="Toggle Blocks Drawer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
        </button>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
