M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawers'], function(Loader, Drawers) {
    window.MoodleDrawers = (Drawers && Drawers.default) ? Drawers.default : Drawers;
    M.util.js_complete('theme_boost/loader');
});

// Global delegated click listeners for Left Sidebar toggle, close button, and backdrop
document.addEventListener('click', function(e) {
    var toggleBtn = e.target.closest('#spaceSidebarToggle, [data-action="toggle-space-sidebar"], .rui-sidebar-toggle-btn');
    if (toggleBtn) {
        window.toggleSpaceSidebar(e);
        return;
    }
    var closeBtn = e.target.closest('.rui-sidebar-close-btn, .rui-sidebar-backdrop');
    if (closeBtn) {
        window.closeSpaceMobileSidebar(e);
        return;
    }
    var closeBlockBtn = e.target.closest('#drawerCloseButtonspace5-drawers-blocks, [data-action="closedrawer"][data-target="theme_boost-drawers-blocks"]');
    if (closeBlockBtn) {
        window.closeBlockDrawer(e);
        return;
    }
    var toggleBlockBtn = e.target.closest('#hiddenSidebarToggle, [data-action="toggle"][data-target="theme_boost-drawers-blocks"]');
    if (toggleBlockBtn) {
        window.toggleBlockDrawer(e);
        return;
    }
});

// Secondary Navigation Tabs - "More" dropdown toggle handler
document.addEventListener('click', function(e) {
    var moreToggle = e.target.closest('.dropdownmoremenu .dropdown-toggle, [data-region="morebutton"] .dropdown-toggle, #moremenu-dropdown-category');
    if (moreToggle) {
        e.preventDefault();
        e.stopPropagation();
        var parent = moreToggle.closest('.dropdownmoremenu, [data-region="morebutton"]');
        var menu = parent ? parent.querySelector('.dropdown-menu') : null;
        if (!menu) return;
        var isShown = menu.classList.contains('show') || parent.classList.contains('show');

        // Close any other open dropdowns
        document.querySelectorAll('.dropdownmoremenu.show, [data-region="morebutton"].show').forEach(function(el) {
            el.classList.remove('show');
            var btn = el.querySelector('.dropdown-toggle');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.dropdownmoremenu .dropdown-menu.show, [data-region="morebutton"] .dropdown-menu.show').forEach(function(el) {
            el.classList.remove('show');
        });

        if (!isShown) {
            parent.classList.add('show');
            menu.classList.add('show');
            moreToggle.setAttribute('aria-expanded', 'true');
        }
        return;
    }

    if (!e.target.closest('.dropdownmoremenu, [data-region="morebutton"]')) {
        document.querySelectorAll('.dropdownmoremenu.show, [data-region="morebutton"].show').forEach(function(el) {
            el.classList.remove('show');
            var btn = el.querySelector('.dropdown-toggle');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.dropdownmoremenu .dropdown-menu.show, [data-region="morebutton"] .dropdown-menu.show').forEach(function(el) {
            el.classList.remove('show');
        });
    }
});

// Interactive Course Actions Handler (Star, Unstar, Hide, Restore)
require(['jquery', 'core/ajax', 'core/notification', 'core/pubsub', 'core_course/events', 'core_user/repository'], function($, ajax, Notification, PubSub, CourseEvents, UserRepository) {
    // Helper to keep both card star button and dropdown options perfectly synchronized
    function updateCourseFavouriteUI(courseId, isFav) {
        var $favBtn = $('[data-action="toggle-favourite"][data-course-id="' + courseId + '"]');
        $favBtn.toggleClass('is-favourite', isFav);
        var $isFavSpan = $favBtn.find('[data-region="is-favourite"]');
        var $notFavSpan = $favBtn.find('[data-region="not-favourite"]');

        if (isFav) {
            $isFavSpan.removeClass('hidden d-none');
            $notFavSpan.addClass('hidden d-none');
            $favBtn.attr('title', 'Unstar this course');
            $favBtn.attr('aria-label', 'Remove from favourites');
        } else {
            $isFavSpan.addClass('hidden d-none');
            $notFavSpan.removeClass('hidden d-none');
            $favBtn.attr('title', 'Star this course');
            $favBtn.attr('aria-label', 'Add to favourites');
        }

        // Sync dropdown menu options
        var $cards = $('[data-region="course-content"][data-course-id="' + courseId + '"], .rui-course-card[data-course-id="' + courseId + '"], .rui-course-list-item[data-course-id="' + courseId + '"]');
        $cards.find('[data-action="add-favourite"]').toggleClass('hidden d-none', isFav);
        $cards.find('[data-action="remove-favourite"]').toggleClass('hidden d-none', !isFav);
    }

    // 1. Star / Unstar from Card Quick-Button
    $(document).on('click', '[data-action="toggle-favourite"]', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $btn = $(this);
        var courseId = parseInt($btn.data('course-id'), 10);
        if (!courseId) return;

        var isFav = $btn.hasClass('is-favourite');
        var newFav = !isFav;

        updateCourseFavouriteUI(courseId, newFav);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: newFav }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(newFav ? CourseEvents.favourited : CourseEvents.unfavorited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, isFav);
            Notification.exception(err);
        });
    });

    // 2. Star this course from Dropdown Menu
    $(document).on('click', '[data-action="add-favourite"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        updateCourseFavouriteUI(courseId, true);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: true }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(CourseEvents.favourited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, false);
            Notification.exception(err);
        });
    });

    // 3. Unstar this course from Dropdown Menu
    $(document).on('click', '[data-action="remove-favourite"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        updateCourseFavouriteUI(courseId, false);

        ajax.call([{
            methodname: 'core_course_set_favourite_courses',
            args: { courses: [{ id: courseId, favourite: false }] }
        }])[0].then(function(result) {
            if (result && result.warnings && result.warnings.length > 0) {
                throw new Error(result.warnings[0].message);
            }
            if (PubSub && CourseEvents) {
                PubSub.publish(CourseEvents.unfavorited, courseId);
            }
        }).catch(function(err) {
            updateCourseFavouriteUI(courseId, true);
            Notification.exception(err);
        });
    });

    // 4. Remove from view (Hide Course)
    $(document).on('click', '[data-action="hide-course"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        var $card = $(this).closest('[data-region="course-content"], .rui-course-card, .rui-course-list-item');
        var $hideItem = $card.find('[data-action="hide-course"]');
        var $showItem = $card.find('[data-action="show-course"]');

        $hideItem.addClass('hidden d-none');
        $showItem.removeClass('hidden d-none');

        // Check active grouping filter
        var currentGrouping = $('[data-region="courses-view"]').attr('data-grouping');
        if (currentGrouping && currentGrouping !== 'allincludinghidden') {
            $card.fadeOut(250, function() {
                $(this).remove();
            });
        }

        UserRepository.setUserPreference('block_myoverview_hidden_course_' + courseId, true)
            .catch(function(err) {
                $hideItem.removeClass('hidden d-none');
                $showItem.addClass('hidden d-none');
                $card.show();
                Notification.exception(err);
            });
    });

    // 5. Restore to view (Show Course)
    $(document).on('click', '[data-action="show-course"]', function(e) {
        e.preventDefault();
        var courseId = parseInt($(this).data('course-id'), 10);
        if (!courseId) return;

        var $card = $(this).closest('[data-region="course-content"], .rui-course-card, .rui-course-list-item');
        var $hideItem = $card.find('[data-action="hide-course"]');
        var $showItem = $card.find('[data-action="show-course"]');

        $showItem.addClass('hidden d-none');
        $hideItem.removeClass('hidden d-none');

        // Check active grouping filter
        var currentGrouping = $('[data-region="courses-view"]').attr('data-grouping');
        if (currentGrouping === 'hidden') {
            $card.fadeOut(250, function() {
                $(this).remove();
            });
        }

        UserRepository.setUserPreference('block_myoverview_hidden_course_' + courseId, null)
            .catch(function(err) {
                $showItem.removeClass('hidden d-none');
                $hideItem.addClass('hidden d-none');
                $card.show();
                Notification.exception(err);
            });
    });

    // PubSub events sync
    if (PubSub && CourseEvents) {
        PubSub.subscribe(CourseEvents.favourited, function(courseId) {
            updateCourseFavouriteUI(courseId, true);
        });
        PubSub.subscribe(CourseEvents.unfavorited, function(courseId) {
            updateCourseFavouriteUI(courseId, false);
        });
    }
});
{{/js}}

