                                        <path d="M11.667,10L5,10M5,10L7.5,7.5M5,10L7.5,12.5" style="fill:none;stroke:currentColor;stroke-width:1.25px;stroke-linecap:round;stroke-linejoin:round;"></path>
                                    </g>
                                </svg>
                            </span>
                        </button>
                    </div>
                    {{/hasblocks}}
                </div>

